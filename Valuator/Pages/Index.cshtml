@page
@model IndexModel
@{
    ViewData["Title"] = "Главная";
}

<div class="text-center">
    <form method="post">

        <div>
            <label for="country">Страна гражданства:</label>
            <select name="SelectedCountry" id="country" asp-for="SelectedCountry" required>
                <option value=""> Выберите страну </option>
                @foreach (var country in Model.Countries)
                {
                    <option value="@country.Country">@country.Country</option>
                }
            </select>
        </div>

        <div class="col-2">Текст для оценки:</div>
        <div class="col-10">
            <textarea name="text" rows="5" cols="50"></textarea>
            <input type="submit" />
        </div>
    </form>
</div>